+export async function getStalePriceFromDb(symbol: string): Promise<MarketQuote | null> {
+  try {
+    const cleanSym = symbol.trim().toUpperCase(), baseSym = cleanSym.replace(/\.PS$/, '');
+    const matchingInstruments = await financeDb.instruments.filter(inst => {
+      if (inst.deletedAt) return false;
+      const s = inst.symbol?.toUpperCase(), src = inst.sourceSymbol?.toUpperCase();
+      return inst.id === symbol || s === cleanSym || src === cleanSym || (Boolean(s) && s!.replace(/\.PS$/, '') === baseSym) || (Boolean(src) && src!.replace(/\.PS$/, '') === baseSym);
+    }).toArray();
+    const instrumentIds = new Set(matchingInstruments.map(i => i.id));
+    instrumentIds.add(symbol);
+    const prices = await financeDb.prices.filter(p => {
+      if (p.deletedAt || !Number.isFinite(p.value) || p.value <= 0) return false;
+      if (instrumentIds.has(p.instrumentId)) return true;
+      const pSym = p.sourceSymbol?.toUpperCase();
+      return pSym ? (pSym === cleanSym || pSym.replace(/\.PS$/, '') === baseSym) : false;
+    }).toArray();
+    if (!prices.length) return null;
+    prices.sort((a, b) => (Date.parse(b.asOf) || Date.parse(b.fetchedAt) || 0) - (Date.parse(a.asOf) || Date.parse(a.fetchedAt) || 0));
+    const latest = prices[0];
+    const matchedInst = matchingInstruments.find(i => i.id === latest.instrumentId);
+    const baseSource = latest.source || 'Saved price';
+    const sourceWithStale = baseSource.toLowerCase().includes('stale') || baseSource.toLowerCase().includes('cache') ? baseSource : `${baseSource} (Stale cache)`;
+    return {
+      symbol: latest.sourceSymbol || matchedInst?.symbol || symbol,
+      name: matchedInst?.name || latest.sourceSymbol || symbol,
+      currency: latest.currency || matchedInst?.currency || 'PHP',
+      assetType: matchedInst?.instrumentType?.toLowerCase().includes('etf') ? 'etf' : 'stock',
+      value: latest.value,
+      source: sourceWithStale,
+      asOf: latest.asOf,
+      freshness: 'stale',
+      isStale: true,
+    };
+  } catch { return null; }
+}
